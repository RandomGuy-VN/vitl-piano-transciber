# ==============================================================================
#                  PRODUCTION DOCKERFILE (GPU / NVIDIA CUDA ACCELERATED)
# ==============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS base

# Ngăn chặn prompt tương tác và cấu hình môi trường Python
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

# Cài đặt Python 3.11/3.12, FFmpeg, SoX, Curl và build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    ffmpeg \
    sox \
    libsox-fmt-all \
    curl \
    ca-certificates \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Tạo người dùng non-root
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

# Sao chép và cài đặt các dependencies Python
COPY requirements.txt .

# Cài đặt PyTorch CUDA 12.1+ và các gói phụ thuộc
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu121 && \
    pip3 install --no-cache-dir -r requirements.txt

# Sao chép mã nguồn
COPY . .

# Phân quyền cho appuser
RUN chown -R appuser:appgroup /app /home/appuser

USER appuser

EXPOSE 8080

# Cấu hình Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

CMD ["python3", "main.py"]
