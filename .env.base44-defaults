# ==============================================================================
# Base44 Development Defaults — overridden by /run/base44/app.env
# ==============================================================================
# Discord Bot Token (required — provided via secrets)
DISCORD_BOT_TOKEN=

# Tùy chọn: ID Guild để đồng bộ slash command ngay
GUILD_ID=

# Tối ưu tốc độ: CPU-only, không preload model
DEVICE=cpu
PRELOAD_MODEL_ON_STARTUP=false

# Model tự "ngủ" (unload RAM) sau 120 phút không có request
MODEL_IDLE_TIMEOUT_MINUTES=120

# Health server + auto style
ENABLE_HEALTH_SERVER=true
ENABLE_AUTO_STYLE=true

# Giới hạn tài nguyên
MAX_CONCURRENT_JOBS=1
CPU_THREADS=0
MAX_FILE_SIZE_MB=50
MAX_AUDIO_DURATION_SECONDS=900

# Tối ưu transcription: hop 16s = no overlap (nhanh nhất)
# Quantize int8 ĐÃ LOẠI — gây overhead + lỗi attribute trên model Transkun
TRANSCRIPTION_HOP_SEC=16
TRANSCRIPTION_SEGMENT_SEC=16
TRANSCRIPTION_QUANTIZE=0
TRANSCRIPTION_COMPILE=0
