# ==============================================================================
#                      VITL PIANO DISCORD BOT CONFIGURATION
# ==============================================================================

# [BẮT BUỘC] Token của Discord Bot từ Discord Developer Portal
# Truy cập: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# [TÙY CHỌN] ID Server Discord để đồng bộ Slash Command ngay lập tức khi phát triển
# Nếu để trống, Bot sẽ đồng bộ Toàn cầu (Global - có thể mất 1-15 phút để hiển thị)
GUILD_ID=

# [TÙY CHỌN] Cấu hình thiết bị xử lý AI: 'auto', 'cuda' (NVIDIA GPU), hoặc 'cpu'
# Khi chạy trên Cloud VPS thông thường/PaaS: đặt 'cpu' hoặc 'auto'
DEVICE=auto

# [CLOUD / DOCKER] Cổng chạy Web Server báo trạng thái Health Check (Mặc định 8080)
PORT=8080
ENABLE_HEALTH_SERVER=true

# [CLOUD / DOCKER] Giới hạn số lượng tác vụ AI chạy đồng thời (Chống tràn RAM / OOM Kill)
# Khuyên dùng: 1 cho instance < 4GB RAM, 2-4 cho server mạnh hoặc GPU
MAX_CONCURRENT_JOBS=1

# [CLOUD / DOCKER] Tự động tải trước và làm nóng mô hình khi khởi động bot
PRELOAD_MODEL_ON_STARTUP=true

# [CLOUD / DOCKER] Số luồng CPU sử dụng cho PyTorch (0 = tự động theo số vCPU)
CPU_THREADS=0

# [TÙY CHỌN] Giới hạn kích thước file đính kèm tối đa (Đơn vị: MB)
MAX_FILE_SIZE_MB=50

# [TÙY CHỌN] Giới hạn thời lượng file âm thanh tối đa (Đơn vị: Giây)
# Mặc định: 900 giây = 15 phút
MAX_AUDIO_DURATION_SECONDS=900

# [TÙY CHỌN] Thời gian tối đa cho quá trình tải nhạc (Đơn vị: Giây)
DOWNLOAD_TIMEOUT_SECONDS=180

# [TÙY CHỌN] Thời gian tối đa cho quá trình AI Transcription (Đơn vị: Giây)
TRANSCRIPTION_TIMEOUT_SECONDS=600

# [TÙY CHỌN] Thông tin Spotify API (Nếu muốn tối ưu hóa tải từ Spotify)
# Lấy tại: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
